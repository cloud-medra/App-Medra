rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil del usuario; {} si no existe (sin perfil se niega todo lo que
    // dependa de rol o permisos, sin error de evaluación). Los campos se leen
    // con get(campo, defecto) porque pueden faltar.
    function getUsuario() {
      let ruta = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(ruta) ? get(ruta).data : {};
    }
    // Sesión de un usuario activo. Al inactivarlo se deshabilita en Auth y se
    // revocan sus sesiones, pero un token ya emitido sigue valiendo hasta una
    // hora: por eso las reglas también lo verifican. Sin perfil o sin el
    // campo `activo`, se considera activo (como antes).
    function estaActivo() {
      return request.auth != null && getUsuario().get('activo', true) != false;
    }
    // Desarrollador: el único rol con acceso total (mismo criterio que
    // esRolAccesoTotal de functions/permisos/nucleo.mjs). El Administrador se
    // rige por sus permisos como cualquier usuario; además puede administrar
    // usuarios si tiene el ítem (administraUsuarios).
    function esDev() {
      return getUsuario().get('rol', '') == 'dev';
    }
    // Administrador (o Desarrollador) con alguno de los ítems de
    // Administración indicados (Crear usuario, Lista de usuarios, Permisos
    // por centro). Mismo criterio que puedeAdministrar de nucleo.mjs.
    function administraUsuarios(rutas) {
      let u = getUsuario();
      return esDev()
        || (u.get('rol', '') == 'admin'
          && u.get('permisos', {}).get('administracion', []).hasAny(rutas));
    }
    // Un ítem de menú puntual (ruta) dentro de permisos[modulo]; sin el
    // módulo, lista vacía en vez de error.
    function tieneItem(modulo, ruta) {
      return ruta in getUsuario().get('permisos', {}).get(modulo, []);
    }
    function tienePermiso(modulo) {
      return getUsuario().get('permisos', {}).get(modulo, null) != null;
    }
    // Acción granular (mismo criterio que useGranularPermission): la vista
    // tiene que existir en permisosGranulares; una sección o acción sin
    // configurar se permite; visible:false o la acción en false se niega.
    // Las acciones de ACCIONES_DENEGADAS_POR_DEFECTO (functions/permisos/
    // nucleo.mjs) NO se validan aquí: van por Cloud Functions.
    function accionPermitida(ruta, seccion, accion) {
      // Sección sin configurar = {} (permitida). Sin `null` en el ternario: el
      // verificador de tipos del deploy no puede asegurar que sea un map.
      let vista = getUsuario().get('permisosGranulares', {}).get(ruta, null);
      let sec = vista == null ? {} : vista.get(seccion, {});
      return vista != null
        && sec.get('visible', true) != false
        && sec.get('elements', {}).get(accion, true) != false;
    }
    // Colecciones con UNA sola pantalla que escribe: además del módulo se
    // exige el ítem de menú (vista) y, en accionEnVista, además la acción
    // granular (ej. "Eliminar", "Importar", "Guardar PAD").
    // Las colecciones compartidas entre pantallas (ej. *_documentos,
    // maestros_codigos) siguen validando solo por módulo.
    function escribeVista(modulo, ruta) {
      return esDev() || (tienePermiso(modulo) && tieneItem(modulo, ruta));
    }
    function accionEnVista(modulo, ruta, seccion, accion) {
      return esDev()
        || (tienePermiso(modulo) && tieneItem(modulo, ruta) && accionPermitida(ruta, seccion, accion));
    }

    match /{path=**}/documentos/{documentId} {
      allow read: if estaActivo();
    }

    // =================================================================
    // REGLA PARA COLLECTION GROUP "detalles" Y SUS SUBCOLECCIONES (logs)
    // =================================================================
    match /{path=**}/detalles/{detalleId} {
      allow read: if estaActivo();
      allow write: if estaActivo() && path.size() > 0 && path[0] != 'documentos_sistema' &&
        (esDev() || tienePermiso('implantes'));
    }

    match /{path=**}/detalles/{detalleId}/logs/{logId} {
      allow read: if estaActivo();
      allow write: if estaActivo() && path.size() > 0 && path[0] != 'documentos_sistema' &&
        (esDev() || tienePermiso('implantes'));
    }

    // =================================================================
    // USUARIOS
    // =================================================================

    // Rol, permisos (el efectivo, calculado), centro de costo, excepciones y
    // estado (activo, sincronizado con Auth) solo los escriben las Cloud
    // Functions de functions/permisos (que exigen rol Administrador con el
    // ítem, o Desarrollador, y no dejan el sistema sin desarrollador). El
    // nombre de usuario (es único: índice nombres_usuario), el bloqueo por
    // intentos fallidos y el correo (se copia del de Auth al entrar, después
    // de que el usuario confirma el cambio) también, con las de
    // functions/usuarios. Desde el navegador, cada usuario actualiza lo suyo
    // (tema, cambio de contraseña…) y quien administra usuarios, los datos no
    // protegidos de los demás (salvo de un Desarrollador).
    function camposProtegidosUsuario() {
      // nombreCompleto, nombreUsuario y email: el usuario los cambia por
      // solicitud (functions/solicitudes); el administrador, en Editar usuario.
      // instituciones (las del selector del header): solo guardarPermisosUsuario.
      return ['rol', 'permisos', 'permisosGranulares', 'centroCostoId', 'excepciones', 'nombreUsuario', 'bloqueoLoginHasta', 'email', 'activo',
        'nombreCompleto', 'centrosAdministrados', 'administradoresAsignados', 'todosLosAdministradoresDelCentro', 'instituciones'];
    }
    function rutasAdministrarUsuarios() {
      return ['/administracion/crearUsuario', '/administracion/listadoUsuario'];
    }
    // Un Administrador no toca el perfil de un Desarrollador (anti-escalada).
    function puedeTocarUsuario(datos) {
      return esDev() || datos.get('rol', '') != 'dev';
    }
    match /usuarios/{userId} {
      // El propio perfil se lee aunque esté inactivo: así la app ve el cambio
      // y cierra la sesión con el aviso (UserContext).
      allow read: if request.auth != null && (request.auth.uid == userId || estaActivo());
      // Otro usuario: solo quien administra usuarios (ej. estadoCreacion de
      // Crear Usuario). Rol, permisos, estado, etc. van por las funciones.
      allow update: if estaActivo()
        && (request.auth.uid == userId
          || (administraUsuarios(rutasAdministrarUsuarios()) && puedeTocarUsuario(resource.data)))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposProtegidosUsuario());
      // El documento base lo crea la función crearUsuario (Crear Usuario),
      // junto con la cuenta y el índice del nombre de usuario.
      allow create: if false;
      // "Cancelar creación" de una cuenta incompleta (Lista de usuarios).
      allow delete: if estaActivo() && administraUsuarios(['/administracion/listadoUsuario'])
        && puedeTocarUsuario(resource.data);

      // Auditoría de permisos (la escriben las funciones).
      match /logs/{logId} {
        allow read: if estaActivo() && administraUsuarios(['/administracion/listadoUsuario']);
        allow write: if false;
      }
    }

    // Índice de nombres de usuario (únicos) e intentos fallidos de login:
    // solo las Cloud Functions de functions/usuarios. No se leen desde el
    // navegador (revelarían qué usuarios existen).
    match /nombres_usuario/{nombre} {
      allow read, write: if false;
    }
    match /intentos_login/{clave} {
      allow read, write: if false;
    }

    // =================================================================
    // SOLICITUDES Y ALERTAS (Ajustes → Datos, Administración → Alertas)
    // =================================================================
    // Solo las escriben las Cloud Functions de functions/solicitudes. Una
    // solicitud la leen quien la pidió, sus aprobadores y los
    // desarrolladores; su historial, lo mismo.
    function puedeVerSolicitud(s) {
      return request.auth.uid == s.solicitanteUid || request.auth.uid in s.aprobadores || esDev();
    }
    match /solicitudes/{id} {
      allow read: if estaActivo() && puedeVerSolicitud(resource.data);
      allow write: if false;
      match /historial/{h} {
        allow read: if estaActivo() && puedeVerSolicitud(get(/databases/$(database)/documents/solicitudes/$(id)).data);
        allow write: if false;
      }
    }
    // Alertas: las ven sus destinatarios (noLeidas ⊆ destinatarios, así el
    // contador del menú puede consultar por noLeidas) y los desarrolladores.
    // Desde el navegador, cada uno solo se quita a sí mismo de noLeidas.
    match /alertas/{id} {
      allow read: if estaActivo()
        && (request.auth.uid in resource.data.destinatarios || request.auth.uid in resource.data.noLeidas || esDev());
      allow update: if estaActivo()
        && request.auth.uid in resource.data.destinatarios
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noLeidas'])
        && request.resource.data.noLeidas == resource.data.noLeidas.removeAll([request.auth.uid]);
      allow create, delete: if false;
    }
    // =================================================================
    // AYUDA Y SOPORTE: TICKETS
    // =================================================================
    // Quién ve cada ticket: su autor, el o los administradores asignados al
    // autor al crearlo (guardados en el propio ticket) y quien gestiona.
    // Todo se valida con campos del ticket y el perfil de quien consulta
    // (getUsuario, que ya se lee para estaActivo): sin leer otros documentos.
    //
    // Permiso "Gestionar tickets" (bandeja completa, responder, cambiar el
    // estado): siempre el Desarrollador; los demás, también un Administrador,
    // solo con el ítem Herramientas → Gestionar tickets asignado.
    function gestionaTickets() {
      return esDev() || tieneItem('administracion', '/administracion/tickets');
    }
    // Administrador asignado al autor del ticket (solo lectura): figura en
    // `administradores` o el autor eligió "todos los administradores" de un
    // centro que él administra (`centroAdministradores`). Tiene que seguir
    // siendo Administrador (activo, por estaActivo) al consultar.
    function veTicketComoAdministrador(t) {
      let u = getUsuario();
      return u.get('rol', '') == 'admin'
        && (request.auth.uid in t.get('administradores', [])
          || (t.get('centroAdministradores', null) != null
            && t.get('centroAdministradores', null) in u.get('centrosAdministrados', [])));
    }
    // Visibilidad de un ticket nuevo: la que corresponde al perfil del autor
    // (mismo cálculo que visibilidadTicket de src/.../soporte/ticketsConfig.js),
    // para que no se pueda mostrar el ticket a otros administradores.
    function visibilidadTicketValida(t) {
      let u = getUsuario();
      let usaAdministradores = u.get('rol', 'operador') in ['operador', 'encargado']
        && !(u.get('centroCostoId', null) in [null, '']);
      let todos = u.get('todosLosAdministradoresDelCentro', false) == true;
      return t.administradores == (usaAdministradores && !todos ? u.get('administradoresAsignados', []) : [])
        && t.centroAdministradores == (usaAdministradores && todos ? u.get('centroCostoId', null) : null);
    }
    // Historial de "Solicitudes de modificaciones" (Implantes, Hemodinamia,
    // Consignación): un documento por descarga, con las filas exactas del
    // archivo. Solo se crea (lo crea quien descarga); no se modifica ni se borra.
    match /modificaciones_exportadas/{id} {
      allow read: if estaActivo() && (esDev() || tienePermiso(resource.data.modulo));
      allow create: if estaActivo()
        && request.resource.data.modulo in ['implantes', 'hemodinamia', 'consignacion']
        && request.resource.data.usuarioUid == request.auth.uid
        && (esDev() || tienePermiso(request.resource.data.modulo));
      allow update, delete: if false;
    }

    // Número correlativo (TK-0001…): solo sube de a uno, en la misma
    // transacción que crea el ticket.
    match /tickets_meta/contador {
      allow read: if estaActivo();
      allow create: if estaActivo() && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == 1;
      allow update: if estaActivo() && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == resource.data.ultimo + 1;
    }
    function ticketNuevoValido(t) {
      return t.creadoPor == request.auth.uid
        && t.numero == getAfter(/databases/$(database)/documents/tickets_meta/contador).data.ultimo
        && t.estado == 'NUEVO'
        && t.tipo in ['ERROR', 'MEJORA', 'CONSULTA']
        && t.prioridad in ['BAJA', 'MEDIA', 'ALTA']
        && t.titulo is string && t.titulo.size() > 0 && t.titulo.size() <= 120
        && t.descripcion is string && t.descripcion.size() > 0 && t.descripcion.size() <= 4000
        && t.capturas is list && t.capturas.size() <= 3
        && t.mensajes is list && t.mensajes.size() == 0
        && t.noLeidoUsuario == false && t.pendienteGestor == true
        && visibilidadTicketValida(t);
    }
    // El creador solo agrega UN mensaje suyo al final de la conversación (sin
    // tocar los anteriores) y marca sus novedades como vistas; el estado y los
    // demás datos los cambia quien gestiona.
    function actualizacionDelCreador() {
      let antes = resource.data;
      let despues = request.resource.data;
      let cambios = despues.diff(antes).affectedKeys();
      let n = antes.mensajes.size();
      return antes.creadoPor == request.auth.uid
        && cambios.hasOnly(['mensajes', 'actualizadoEl', 'noLeidoUsuario', 'pendienteGestor'])
        && despues.noLeidoUsuario == false
        && (!cambios.hasAny(['mensajes'])
          || (despues.mensajes.size() == n + 1
            && despues.mensajes[0:n] == antes.mensajes
            && despues.mensajes[n].autorUid == request.auth.uid
            && despues.mensajes[n].tipo == 'mensaje'
            && despues.mensajes[n].deGestor == false
            && despues.pendienteGestor == true));
    }
    // Un ticket = un documento con su conversación (abrirlo cuesta 1 lectura).
    // Leen: su autor, sus administradores asignados (solo lectura) y quien
    // gestiona. Escriben: el autor (su mensaje / marcar visto) y quien gestiona.
    match /tickets/{ticketId} {
      allow read: if estaActivo()
        && (resource.data.creadoPor == request.auth.uid
          || gestionaTickets()
          || veTicketComoAdministrador(resource.data));
      allow create: if estaActivo() && ticketNuevoValido(request.resource.data);
      allow update: if estaActivo() && (gestionaTickets() || actualizacionDelCreador());
      allow delete: if false;
    }

    // Correos de la extensión Trigger Email (functions/alertas/correo.js):
    // solo los escribe la función; nadie los lee desde el navegador.
    match /mail/{id} {
      allow read, write: if false;
    }

    // Plantillas de permisos por centro de costo (id = id de maestros_centros):
    // solo las escribe guardarPlantillaCentroCosto.
    // Las leen Crear usuario y Editar usuario (vista previa del permiso
    // heredado) y Permisos por centro.
    match /plantillas_permisos/{centroId} {
      allow read: if estaActivo() && administraUsuarios(['/administracion/crearUsuario', '/administracion/listadoUsuario', '/administracion/permisosCentro']);
      allow write: if false;
      match /logs/{logId} {
        allow read: if estaActivo() && administraUsuarios(['/administracion/permisosCentro']);
        allow write: if false;
      }
    }

    // =================================================================
    // LABORATORIO
    // =================================================================

    // fchEmis (fecha de emisión de la factura) en 'AAAA-MM-DD', como el XML
    // del SII: Finanzas → Comparativo mensual filtra por rango sobre ese
    // texto (src/components/modulos/gestiones/shared/fechaISO.js). Solo se
    // valida si el documento trae el campo (años, meses y logs no lo tienen).
    function fchEmisValida() {
      let d = request.resource.data;
      return !('fchEmis' in d) || (d.fchEmis is string && d.fchEmis.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    match /laboratorio_empresas/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && escribeVista('laboratorio', '/laboratorio/empresasLaboratorio');
      allow delete: if estaActivo()
        && accionEnVista('laboratorio', '/laboratorio/empresasLaboratorio', 'tabla_datos', 'action_eliminar');
    }

    match /laboratorio_codigos/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && escribeVista('laboratorio', '/laboratorio/codigoLaboratorio');
      allow delete: if estaActivo()
        && accionEnVista('laboratorio', '/laboratorio/codigoLaboratorio', 'tabla', 'btn_eliminar');
    }

    match /laboratorio_ordenes/{document=**} {
      allow read: if estaActivo();
      // Toda escritura de Órdenes es la importación desde Excel.
      allow write: if estaActivo()
        && accionEnVista('laboratorio', '/laboratorio/ordenLaboratorio', 'cabecera_acciones', 'btn_importar');
    }

    match /laboratorio_documentos/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && (esDev() || tienePermiso('laboratorio')) && fchEmisValida();
      allow delete: if estaActivo() && (esDev() || tienePermiso('laboratorio'));
    }

    match /laboratorio_cierres/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('laboratorio'));
    }
    match /laboratorio_imputadas/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && (esDev() || tienePermiso('laboratorio')) && fchEmisValida();
      allow delete: if estaActivo() && (esDev() || tienePermiso('laboratorio'));
    }

    // =================================================================
    // VACUNATORIO
    // =================================================================

    match /vacunatorio_empresas/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && escribeVista('vacunatorio', '/vacunatorio/empresasVacunatorio');
      allow delete: if estaActivo()
        && accionEnVista('vacunatorio', '/vacunatorio/empresasVacunatorio', 'tabla_datos', 'action_eliminar');
    }

    match /vacunatorio_codigos/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && escribeVista('vacunatorio', '/vacunatorio/codigoVacunatorio');
      allow delete: if estaActivo()
        && accionEnVista('vacunatorio', '/vacunatorio/codigoVacunatorio', 'tabla', 'btn_eliminar');
    }

    match /vacunatorio_ordenes/{document=**} {
      allow read: if estaActivo();
      // Toda escritura de Órdenes es la importación desde Excel.
      allow write: if estaActivo()
        && accionEnVista('vacunatorio', '/vacunatorio/ordenVacunatorio', 'cabecera_acciones', 'btn_importar');
    }

    match /vacunatorio_documentos/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && (esDev() || tienePermiso('vacunatorio')) && fchEmisValida();
      allow delete: if estaActivo() && (esDev() || tienePermiso('vacunatorio'));
    }

    match /vacunatorio_cierres/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('vacunatorio'));
    }
    match /vacunatorio_imputadas/{document=**} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && (esDev() || tienePermiso('vacunatorio')) && fchEmisValida();
      allow delete: if estaActivo() && (esDev() || tienePermiso('vacunatorio'));
    }

    // =================================================================
    // ADMINISTRACION -PERÍODOS (multi-módulo: laboratorio, vacunatorio, hemodinamia,
    // implantes, consignación, etc. — según CierreMes.jsx)
    // =================================================================

    // El cierre de un período (estado 'CERRADO') lo hace la Cloud Function
    // cerrarPeriodoImputacion, que valida en el servidor el año/mes escritos
    // por el usuario (el Admin SDK no pasa por estas reglas). El cliente solo
    // puede dejar un período en CERRADO en el cierre automático de la
    // apertura: en el mismo batch en que abre otro período del mismo módulo,
    // indicado en `cerradoPorApertura`.
    function esCierreAutomaticoPorApertura(cierreId) {
      let despues = request.resource.data;
      let abierto = getAfter(/databases/$(database)/documents/cierres_periodos/$(despues.cerradoPorApertura));
      return resource.data.estado in ['ABIERTO', 'REABIERTO'] &&
        despues.get('cierreAutomatico', false) == true &&
        despues.cerradoPorApertura is string &&
        despues.cerradoPorApertura != cierreId &&
        abierto != null &&
        abierto.data.estado == 'ABIERTO' &&
        abierto.data.modulo == resource.data.modulo &&
        // fechaApertura = serverTimestamp() de esta misma escritura: prueba
        // que se abrió en este batch y no que ya estuviera abierto antes.
        abierto.data.get('fechaApertura', null) == request.time;
    }

    // Bodega: un mes no se reabre si el siguiente ya está cerrado (tomó su
    // saldo final como saldo inicial). Id: {anio}_{mes}_bodega.
    function siguienteBodegaCerrado(cierreId) {
      let partes = cierreId.split('_');
      let siguiente = {'enero': 'febrero', 'febrero': 'marzo', 'marzo': 'abril', 'abril': 'mayo', 'mayo': 'junio',
        'junio': 'julio', 'julio': 'agosto', 'agosto': 'septiembre', 'septiembre': 'octubre', 'octubre': 'noviembre',
        'noviembre': 'diciembre', 'diciembre': 'enero'};
      let anio = partes[1] == 'diciembre' ? string(int(partes[0]) + 1) : partes[0];
      let ruta = /databases/$(database)/documents/cierres_periodos/$(anio + '_' + siguiente[partes[1]] + '_bodega');
      return exists(ruta) && get(ruta).data.get('estado', '') == 'CERRADO';
    }
    function reaperturaPermitida(cierreId) {
      return resource.data.modulo != 'bodega' ||
        request.resource.data.get('estado', '') != 'REABIERTO' ||
        resource.data.get('estado', '') != 'CERRADO' ||
        !siguienteBodegaCerrado(cierreId);
    }

    match /cierres_periodos/{cierreId} {
      allow read: if estaActivo();
      allow create: if estaActivo() &&
        (esDev() || tienePermiso(request.resource.data.modulo)) &&
        request.resource.data.get('estado', '') != 'CERRADO';
      allow update: if estaActivo() &&
        (esDev() || tienePermiso(resource.data.modulo)) &&
        request.resource.data.modulo == resource.data.modulo &&
        reaperturaPermitida(cierreId) &&
        (request.resource.data.get('estado', '') != 'CERRADO' || esCierreAutomaticoPorApertura(cierreId));
      allow delete: if estaActivo() &&
        (esDev() || tienePermiso(resource.data.modulo));
    }

    // Snapshot mensual consolidado por módulo (usado por "Período Actual" para
    // comparar mes actual vs. mes anterior sin recalcular sumando documentos crudos).
    // Doc ID: {anio}_{mes}_{modulo}, con campo "modulo" siempre presente.
    match /imputaciones_periodos/{snapshotId} {
      allow read: if estaActivo();
      allow create: if estaActivo() &&
        (esDev() || tienePermiso(request.resource.data.modulo));
      allow update, delete: if estaActivo() &&
        (esDev() || tienePermiso(resource.data.modulo));
    }

    match /documentos_imputados/{modulo}/{path=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() &&
        (esDev() || tienePermiso(modulo));
    }

    // Configuración global del sistema (p. ej. atajosDashboard: atajos del
    // Dashboard). La leen todos; solo el Desarrollador la modifica.
    match /configuracion_sistema/{docId} {
      allow read: if estaActivo();
      allow write: if estaActivo() && esDev();
    }

    match /configuracion_periodos/{modulo} {
      allow read: if estaActivo();
      allow write: if estaActivo() &&
        (esDev() || tienePermiso(modulo));
    }

    // Notas del panel: cada una dice qué roles la ven (rolesVisibles, nunca
    // vacío: admin/operador/encargado, o ['dev'] para una nota solo de
    // desarrolladores). El Desarrollador ve todas. Las consultas del resto
    // tienen que filtrar por su rol (where('rolesVisibles', 'array-contains',
    // rol)) o se rechazan; un usuario sin rol cuenta como operador.
    function puedeVerNota(nota) {
      let u = getUsuario();
      let rol = u.get('rol', 'operador');
      // Sin perfil (usuarios/{uid} no existe) no se ve ninguna.
      return u.size() > 0 && (rol == 'dev' || rol in nota.get('rolesVisibles', []));
    }
    function notaValida(nota) {
      return nota.rolesVisibles is list
        && nota.rolesVisibles.size() > 0
        && nota.rolesVisibles.toSet().hasOnly(['admin', 'operador', 'encargado', 'dev'])
        && (!('estilo' in nota) || nota.estilo is map);
    }
    // Al editar, roles y estilo se validan solo si cambian: mover una nota
    // (orden) o marcar su checklist no exige que ya tenga rolesVisibles (las
    // notas anteriores a la migración siguen funcionando).
    function edicionDeNotaValida() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rolesVisibles', 'estilo'])
        || notaValida(request.resource.data);
    }
    match /administracion_notas/{notaId} {
      allow read: if estaActivo() && puedeVerNota(resource.data);
      allow create: if estaActivo() && (esDev() || tienePermiso('administracion'))
        && notaValida(request.resource.data);
      allow update: if estaActivo() && (esDev() || tienePermiso('administracion'))
        && puedeVerNota(resource.data) && edicionDeNotaValida();
      allow delete: if estaActivo() && (esDev() || tienePermiso('administracion'))
        && puedeVerNota(resource.data);
    }

    // =================================================================
    // RECORDATORIOS (Administración → Recordatorios + recuadro flotante)
    // =================================================================
    // Pestañas de la vista /administracion/recordatorios (mismo criterio que
    // recordatoriosConfig.js): "mis" = recibe recordatorios; "administrar" =
    // crea, edita, desactiva y borra tareas y ve el historial de todos.
    function tienePestanaRecordatorios(pestana) {
      return tieneItem('administracion', '/administracion/recordatorios')
        && ('/administracion/recordatorios/' + pestana) in getUsuario().get('permisosGranulares', {});
    }
    function recibeRecordatorios() {
      return esDev() || tienePestanaRecordatorios('mis');
    }
    function administraRecordatorios() {
      return esDev() || tienePestanaRecordatorios('administrar');
    }
    function tareaRecordatorioValida(t) {
      return t.keys().hasOnly(['titulo', 'descripcion', 'dias', 'hora', 'asignados', 'activa', 'desde', 'creadoPor', 'creadoEn', 'actualizadoEn'])
        && t.titulo is string && t.titulo.size() > 0 && t.titulo.size() <= 120
        && t.get('descripcion', '') is string && t.get('descripcion', '').size() <= 1000
        && t.dias is list && t.dias.size() > 0 && t.dias.toSet().hasOnly([1, 2, 3, 4, 5, 6, 7])
        && t.get('hora', '') is string
        && (t.get('hora', '') == '' || t.get('hora', '').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && t.asignados is list && t.asignados.size() > 0 && t.asignados.size() <= 200
        && t.activa is bool
        && t.desde is string && t.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // Cada usuario lee solo las tareas donde está asignado (consulta
    // array-contains con su uid); quien administra, todas.
    match /recordatorios_tareas/{tareaId} {
      allow read: if estaActivo()
        && (administraRecordatorios() || (recibeRecordatorios() && request.auth.uid in resource.data.asignados));
      allow create: if estaActivo() && administraRecordatorios()
        && tareaRecordatorioValida(request.resource.data);
      allow update: if estaActivo() && administraRecordatorios()
        && tareaRecordatorioValida(request.resource.data)
        && request.resource.data.desde == resource.data.desde;
      allow delete: if estaActivo() && administraRecordatorios();
    }
    // "Realizado" de una repetición = historial (quién y cuándo). Solo el
    // propio usuario lo crea, sobre una tarea que le está asignada, con la
    // hora del servidor; nadie lo edita ni lo borra.
    match /recordatorios_realizados/{uid}/realizados/{realizadoId} {
      allow read: if estaActivo() && (request.auth.uid == uid || administraRecordatorios());
      allow create: if estaActivo() && request.auth.uid == uid && recibeRecordatorios()
        && request.resource.data.keys().hasOnly(['tareaId', 'titulo', 'fecha', 'uid', 'usuarioNombre', 'realizadoEn'])
        && request.resource.data.uid == uid
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && realizadoId == request.resource.data.tareaId + '_' + request.resource.data.fecha
        && request.resource.data.realizadoEn == request.time
        && request.resource.data.titulo is string && request.resource.data.usuarioNombre is string
        && uid in get(/databases/$(database)/documents/recordatorios_tareas/$(request.resource.data.tareaId)).data.asignados;
      allow update, delete: if false;
    }

    // =================================================================
    // MAESTRO
    // =================================================================

    match /maestros_empresas/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('maestros'));
    }

    match /maestros_prestadores/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('maestros'));
    }

    // Un centro con stock en tránsito (o dejado en el centro) en Bodega no se
    // puede borrar (se inactiva): el tránsito quedaría apuntando a un centro
    // inexistente.
    function centroConTransitoBodega(centroId) {
      let ruta = /databases/$(database)/documents/bodega_transito_centros/$(centroId);
      return exists(ruta) && (get(ruta).data.get('unidades', 0) > 0 || get(ruta).data.get('enCentro', 0) > 0);
    }
    match /maestros_centros/{centroId} {
      allow read: if estaActivo();
      allow create, update: if estaActivo() && (esDev() || tienePermiso('maestros'));
      allow delete: if estaActivo() && (esDev() || tienePermiso('maestros'))
        && !centroConTransitoBodega(centroId);
      // Subcolecciones (logs). Con {subcoleccion} delante: un {document=**}
      // solo también calzaría con el propio centro (cero segmentos) y
      // permitiría borrarlo.
      match /{subcoleccion}/{document=**} {
        allow read: if estaActivo();
        allow write: if estaActivo() && (esDev() || tienePermiso('maestros'));
      }
    }

    // Maestros → Instituciones: instituciones / sucursales del selector del
    // header. La lee cualquier usuario activo; la escribe solo quien tiene el
    // ítem de Maestros (o el Desarrollador). Largos máximos: los mismos de
    // LARGO_MAXIMO en institucionesMaestros/instituciones.js. Que haya una
    // sola predeterminada lo asegura la pantalla (writeBatch); una inactiva
    // no puede ser la predeterminada.
    function textoOpcional(d, campo, maximo) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= maximo);
    }
    function institucionValida(d) {
      return d.keys().hasOnly(['nombre', 'nombreCorto', 'rut', 'direccion', 'ciudad', 'telefono', 'email', 'activa', 'predeterminada',
          'creadoEl', 'creadoPor', 'creadoPorUid', 'actualizadoEl', 'actualizadoPor', 'actualizadoPorUid'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && textoOpcional(d, 'nombreCorto', 30)
        && textoOpcional(d, 'rut', 20)
        && textoOpcional(d, 'direccion', 200)
        && textoOpcional(d, 'ciudad', 80)
        && textoOpcional(d, 'telefono', 30)
        && textoOpcional(d, 'email', 120)
        && textoOpcional(d, 'creadoPor', 120)
        && textoOpcional(d, 'actualizadoPor', 120)
        && d.activa is bool && d.predeterminada is bool
        && (d.activa || !d.predeterminada);
    }
    match /maestros_instituciones/{institucionId} {
      allow read: if estaActivo();
      allow create, update: if estaActivo()
        && escribeVista('maestros', '/maestros/institucionesMaestros')
        && institucionValida(request.resource.data);
      allow delete: if estaActivo()
        && escribeVista('maestros', '/maestros/institucionesMaestros');
    }

    // Bodymap: Maestro "Zonas por diagnóstico". Lo lee quien ve gestiones;
    // las entradas y el contador de gestiones los crean/mantienen la Cloud
    // Function y el script (functions/bodymap). Desde la pantalla solo se
    // editan zonas, lado y estado, con la acción "Editar" del Maestro.
    function editaZonasDiagnostico() {
      return accionEnVista('maestros', '/maestros/zonasDiagnostico', 'tabla_datos', 'action_editar');
    }
    match /maestros_zonas_diagnostico/{descripcionId} {
      allow read: if estaActivo();
      allow create, delete: if false;
      allow update: if estaActivo() && editaZonasDiagnostico()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['zonas', 'lado', 'estado', 'actualizadoPor', 'actualizadoPorUid', 'actualizadoEl'])
        && request.resource.data.zonas is list && request.resource.data.zonas.size() <= 20
        && request.resource.data.estado in ['sin_asignar', 'sugerida', 'confirmada']
        && request.resource.data.lado in ['no_especificado', 'derecho', 'izquierdo', 'bilateral'];
      match /logs/{logId} {
        allow read: if estaActivo();
        allow create: if estaActivo() && editaZonasDiagnostico();
        allow update, delete: if false;
      }
    }

    match /maestros_previsiones/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('maestros'));
    }

    match /maestros_convenios/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('maestros'));
    }

    match /maestros_recargos/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('maestros'));
    }

    // Códigos: los edita el módulo Maestros (como antes) o quien tenga el
    // ítem Implantes → Códigos o Hemodinamia → Códigos (misma pantalla,
    // permisos propios).
    match /maestros_codigos/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('maestros')
        || tieneItem('implantes', '/implantes/codigosImplantes')
        || tieneItem('hemodinamia', '/hemodinamia/codigosHemodinamia'));
    }

    // Registro de auditoría de cada importación masiva de precios
    // (Maestros → Actualización Precios). Inmutable una vez creado.
    match /maestros_codigos_importaciones_precios/{importacionId} {
      allow read: if estaActivo();
      allow create: if estaActivo() && (esDev() || tienePermiso('maestros'));
      allow update, delete: if false;
    }

    match /maestros_pad/{document=**} {
      allow read: if estaActivo();
      // Toda escritura de PAD es "Guardar / Actualizar PAD" (incluye el
      // reemplazo de la receta de ítems).
      allow write: if estaActivo()
        && accionEnVista('maestros', '/maestros/padMaestros', 'acciones_pad', 'btn_guardar');
    }

    match /maestros_listados/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('maestros'));
    }

    // =================================================================
    // CONSIGNACION
    // =================================================================

    match /consignacion_guias/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('consignacion'));
    }

    // N° de orden de un registro (columna ORDEN de Registro). `ordenOrigen`
    // dice de dónde vino: 'oc' = Sincronizar OC (Importar Detalles OC),
    // 'manual' = escrito en la celda, '' o sin el campo = vacío/anterior.
    // Una orden sincronizada queda bloqueada: ni orden ni ordenOrigen
    // cambian más (nadie, tampoco admin/dev). Mientras no esté bloqueada:
    // la sincronización escribe orden + ordenOrigen 'oc'; a mano, solo
    // números separados por ", " (mismo formato que normalizarOrdenManual).
    // Solo se valida si el update toca esos campos: editar estado, guía,
    // etc. de registros antiguos con texto libre en orden sigue funcionando.
    // Aplica a cualquier documento bajo consignacion_registros (carpetas y
    // logs no tienen esos campos).
    function ordenConsignacionBloqueada(datos) {
      return datos.get('ordenOrigen', '') == 'oc';
    }
    function ordenConsignacionNuevaValida(datos) {
      let orden = datos.get('orden', '');
      let origen = datos.get('ordenOrigen', '');
      return orden is string
        && (origen == 'oc' ? orden.size() > 0
          : (origen in ['manual', ''] && (orden == '' || orden.matches('^[0-9]+(, [0-9]+)*$'))));
    }
    function edicionOrdenConsignacionValida() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orden', 'ordenOrigen'])
        || (!ordenConsignacionBloqueada(resource.data) && ordenConsignacionNuevaValida(request.resource.data));
    }
    match /consignacion_registros/{document=**} {
      allow read: if estaActivo();
      allow create, delete: if estaActivo() && (esDev() || tienePermiso('consignacion'));
      allow update: if estaActivo() && (esDev() || tienePermiso('consignacion'))
        && edicionOrdenConsignacionValida();
    }

    match /consignacion_imputadas/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('consignacion'));
    }

    // =================================================================
    // INVENTARIO
    // =================================================================

    match /inventario_general/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('inventario'));
    }

    match /inventario_transito/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('inventario'));
    }

    match /inventario_historial/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('inventario'));
    }

    match /inventario_egresos/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('inventario'));
    }

    // Escaneo: vínculos código de barras -> producto del maestro. El id del
    // documento es el código (un código apunta a un solo producto).
    // Documentos (empresa + guía/factura + OC) ya ingresados: equivalente a
    // un índice único. Se crea con cada ingreso con guía o factura; solo se
    // puede reescribir si el ingreso al que apunta ya no existe (se eliminó
    // de Stock General).
    match /inventario_ingresos_documentos/{id} {
      allow read: if estaActivo();
      allow create: if estaActivo() && (esDev() || tienePermiso('inventario'));
      allow update: if estaActivo() && (esDev() || tienePermiso('inventario'))
        && !exists(/databases/$(database)/documents/inventario_general/$(resource.data.ingresoId));
      allow delete: if estaActivo() && esDev();
    }

    match /inventario_codigos_barra/{codigo} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('inventario'));
    }

    // Inventario por cajas: inventarios_fisicos/{id} (+ subcolección
    // cajas) y el documento _control con el inventario en curso.
    match /inventarios_fisicos/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('inventario'));
    }

    // =================================================================
    // BODEGA (módulo nuevo, independiente de INVENTARIO)
    // =================================================================
    // El navegador solo LEE: toda escritura (productos, códigos de barra,
    // stock, kardex, tránsito, inventario) pasa por las Cloud Functions de
    // functions/bodega, que validan permisos granulares y saldos dentro de
    // una transacción.
    function leeBodega() {
      return estaActivo() && (esDev() || tienePermiso('bodega'));
    }
    match /bodega_productos/{document=**} {
      allow read: if leeBodega();
    }
    match /bodega_codigos_barra/{document=**} {
      allow read: if leeBodega();
    }
    match /bodega_catalogos/{document=**} {
      allow read: if leeBodega();
    }
    match /bodega_lotes/{document=**} {
      allow read: if leeBodega();
    }
    // Control Mensual, Período Actual y Finanzas → Valorización de bodega
    // suman los movimientos del periodo abierto (sum() de su valor) para el
    // saldo de Bodega. Solo lectura: se usa únicamente en `allow read`.
    function leePeriodosBodega() {
      return estaActivo() && (tieneItem('administracion', '/administracion/controlMensual')
        || tieneItem('administracion', '/administracion/ResumenPeriodoAbierto')
        || tieneItem('administracion', '/administracion/valorizacionBodega'));
    }
    match /bodega_movimientos/{document=**} {
      allow read: if leeBodega() || leePeriodosBodega();
    }
    // Foto fija de cada periodo cerrado (la escribe el trigger bodegaPeriodo).
    match /bodega_periodos/{document=**} {
      allow read: if leeBodega() || leePeriodosBodega();
    }
    match /bodega_documentos/{document=**} {
      allow read: if leeBodega();
    }
    match /bodega_salidas/{document=**} {
      allow read: if leeBodega();
    }
    match /bodega_transitos/{document=**} {
      allow read: if leeBodega();
    }
    match /bodega_inventarios/{document=**} {
      allow read: if leeBodega();
    }
    match /bodega_control/{document=**} {
      allow read: if leeBodega();
    }
    // Cajas (kits) con su historial de inventarios y reposiciones.
    match /bodega_cajas/{document=**} {
      allow read: if leeBodega();
    }
    // Stock consignado: lo que cada empresa dejó (con su auditoría).
    match /bodega_consignaciones/{document=**} {
      allow read: if leeBodega();
    }
    // Totales del tránsito por centro: también los lee Maestros → Centros
    // para avisar antes de borrar un centro con tránsito.
    match /bodega_transito_centros/{centroId} {
      allow read: if leeBodega() || (estaActivo() && tienePermiso('maestros'));
    }
    // bodega_unicos (candados de unicidad): solo las Cloud Functions.

    // =================================================================
    // DOCUMENTOS
    // =================================================================


    match /{path=**}/registros/{registroId} {
     allow read: if estaActivo();
     allow write: if estaActivo() && (esDev() || tienePermiso('documentos'));
    }

    // Reportes Info es la misma pantalla en Documentos y en Implantes
    // (/implantes/reportesInfo): escribe (Revisado, importar Excel) quien
    // tenga Documentos o, en Implantes, específicamente ese ítem.
    // Reporte Info → "Gestión implante": marca por número de admisión. Solo
    // la escriben la Cloud Function y el script (functions/admisiones).
    match /admisiones_gestionadas_implantes/{admision} {
      allow read: if estaActivo();
      allow write: if false;
    }
    // "Gestión consignación": la misma marca para Consignación.
    match /admisiones_gestionadas_consignacion/{admision} {
      allow read: if estaActivo();
      allow write: if false;
    }

    // Reporte Info → Maestro "Descripciones ocultas": las entradas y el
    // contador de filas los mantienen la Cloud Function y el script
    // (functions/descripcionesReporte). Desde el Maestro se cambian los dos
    // switches; desde Reporte Info, la acción rápida solo OCULTA en su módulo.
    function editaDescripcionesOcultas() {
      return accionEnVista('maestros', '/maestros/descripcionesOcultas', 'tabla_datos', 'action_editar');
    }
    function camposDescripcionCambiados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function ocultaDesdeReporte(modulo, campo) {
      return camposDescripcionCambiados().hasOnly([campo, 'actualizadoPor', 'actualizadoPorUid', 'actualizadoEl'])
        && request.resource.data[campo] == true
        && accionEnVista(modulo, '/' + modulo + '/reportesInfo', 'filas_ocultas', 'action_ocultarDescripcion');
    }
    match /maestros_descripciones_reporte/{descripcionId} {
      allow read: if estaActivo();
      allow create, delete: if false;
      allow update: if estaActivo()
        && camposDescripcionCambiados().hasOnly(['ocultaImplantes', 'ocultaDocumentos', 'actualizadoPor', 'actualizadoPorUid', 'actualizadoEl'])
        && request.resource.data.get('ocultaImplantes', false) is bool
        && request.resource.data.get('ocultaDocumentos', false) is bool
        && (editaDescripcionesOcultas()
          || ocultaDesdeReporte('implantes', 'ocultaImplantes')
          || ocultaDesdeReporte('documentos', 'ocultaDocumentos'));
    }

    match /documentos_reportesInfo/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('documentos')
        || tieneItem('implantes', '/implantes/reportesInfo'));
    }

    // Importar Detalles OC: documentos_sistema/{anio}/meses/{mes}/admisiones/
    // {admision}/empresas/{proveedorSlug}/detalles/{idFila}, con documentos
    // "marcadores" (merge:true, {active:"true"}) en cada nivel intermedio.
    // Excluida explícitamente de la regla genérica de "detalles" de más
    // arriba (esa es solo para implantes/consignación/hemodinamia) para que
    // el permiso 'implantes' no habilite escritura acá: en Implantes escribe
    // solo quien tenga el ítem Implantes → Importar Detalles OC (misma
    // pantalla y datos que en Documentos).
    function escribeDetallesOC() {
      return esDev() || tienePermiso('documentos')
        || tieneItem('implantes', '/implantes/importarDetallesOC');
    }
    match /documentos_sistema/{anio} {
      allow read: if estaActivo();
      allow write: if estaActivo() && escribeDetallesOC();

      match /meses/{mes} {
        allow read: if estaActivo();
        allow write: if estaActivo() && escribeDetallesOC();

        match /admisiones/{admision} {
          allow read: if estaActivo();
          allow write: if estaActivo() && escribeDetallesOC();

          match /empresas/{proveedor} {
            allow read: if estaActivo();
            allow write: if estaActivo() && escribeDetallesOC();

            match /detalles/{idFila} {
              allow read: if estaActivo();
              allow write: if estaActivo() && escribeDetallesOC();
            }
          }
        }
      }
    }

    // Resumen Mensual de facturación de Detalles OC: un documento por año
    // ({anio, meses: {MM: totales}, actualizadoEn}). Lo escriben Importar
    // Detalles OC / Eliminar filas al terminar y "Recalcular" (Seguimiento →
    // Resumen Mensual), con el mismo permiso que escribe las filas, también
    // desde Implantes → Seguimiento de Facturas y Guías.
    match /resumen_facturacion_mensual/{anio} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (escribeDetallesOC()
        || tieneItem('implantes', '/implantes/seguimientoFacturasGuias'));
    }

    // =================================================================
    // IMPLANTES
    // =================================================================

    // Versión del índice de OC (ver snapshots/indiceOC en storage.rules).
    // La importación publica la versión (documentos); la sincronización deja
    // constancia de la última versión aplicada (implantes).
    // Respaldo de las filas de Detalles OC eliminadas desde Importar Detalles
    // OC ("Eliminar filas seleccionadas": rol Administrador con la acción,
    // o Desarrollador, en pantalla). Se crea en el mismo lote que el borrado;
    // contiene datos de pacientes: solo el Desarrollador la lee (la app no la
    // lee), y nadie la modifica ni la borra.
    match /detallesOCEliminados/{docId} {
      allow read: if estaActivo() && esDev();
      allow create: if estaActivo() && escribeDetallesOC();
      allow update, delete: if false;
    }

    match /ocImport/{docId} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('hemodinamia'));
    }

    // Registro de qué OC tienen PDF (ordenes_oc/ en Storage): un documento
    // ordenesOC/registroPdf con { pdfs: { [oc]: {subidoEn, subidoPor} } }.
    match /ordenesOC/{docId} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('hemodinamia'));
    }

    match /implantes_gestiones/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('implantes'));
    }

    match /implantes_imputadas/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('implantes'));
    }

    // =================================================================
    // IMPLANTES → FIBRAS REUTILIZABLES (operaciones/implantes/fibras)
    // =================================================================
    // Una fibra física por documento (id = código interno, FIB-0001). Sus
    // usos y pérdidas se escriben desde el navegador en transacciones
    // (Gestiones al guardar o eliminar, y la pantalla Fibras). Aunque alguien
    // se salte la app, estas reglas garantizan el contador:
    //  - cada alta o baja cambia la fibra en exactamente un número
    //    (ultimoCambio) y el uso con ese número se crea o anula en la misma
    //    escritura (get/getAfter);
    //  - nunca más usos que usosTotales ni dos vigentes con el mismo número;
    //  - los usos no se borran: se anulan y quedan en el historial.
    function rutaFibras() {
      return '/implantes/fibrasReutilizables';
    }
    function accionFibras(seccion, accion) {
      return accionEnVista('implantes', rutaFibras(), seccion, accion);
    }
    // Anular una pérdida está denegada por defecto (ACCIONES_DENEGADAS_POR_
    // DEFECTO): exige la acción en true explícito, no basta "sin configurar".
    function anulaPerdidas() {
      let vista = getUsuario().get('permisosGranulares', {}).get(rutaFibras(), null);
      let sec = vista == null ? {} : vista.get('tabla_fibras', {});
      return esDev()
        || (tienePermiso('implantes') && tieneItem('implantes', rutaFibras()) && vista != null
          && sec.get('visible', true) != false
          && sec.get('elements', {}).get('action_anular_perdida', false) == true);
    }
    function esFechaISO(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function fibraCoherente(d) {
      return d.usosTotales in [5, 10]
        && d.usosPrevios is int && d.usosPrevios >= 0
        && d.numerosOcupados is list
        && d.numerosOcupados.toSet().size() == d.numerosOcupados.size()
        && d.usosConsumidos == d.usosPrevios + d.numerosOcupados.size()
        && d.usosConsumidos <= d.usosTotales
        && d.estado == (d.usosConsumidos == d.usosTotales ? 'AGOTADA' : 'ACTIVA')
        && (d.usosTotales == 10 || !d.numerosOcupados.hasAny([6, 7, 8, 9, 10]))
        && d.fechasUso is map && d.fechasUso.size() == d.numerosOcupados.size();
    }
    // Ningún uso o pérdida vigente con fecha posterior a `v` (fechasUso tiene
    // a lo más 10 números: se revisan uno por uno, las reglas no tienen bucles).
    function sinUsoPosterior(m, v) {
      return m.get('1', '0') <= v && m.get('2', '0') <= v && m.get('3', '0') <= v
        && m.get('4', '0') <= v && m.get('5', '0') <= v && m.get('6', '0') <= v
        && m.get('7', '0') <= v && m.get('8', '0') <= v && m.get('9', '0') <= v
        && m.get('10', '0') <= v;
    }

    match /implantes_fibras/{fibraId} {
      function refUso(usoId) {
        return /databases/$(database)/documents/implantes_fibras/$(fibraId)/usos/$(usoId);
      }
      // Alta: un número libre (después de los usos previos y hasta el total)
      // pasa a ocupado, con la fecha del uso, y el uso nuevo con ese número se
      // crea en la misma escritura.
      function esAlta() {
        let antes = resource.data;
        let d = request.resource.data;
        let c = d.ultimoCambio;
        let n = string(c.numero);
        return c.tipo == 'ALTA'
          && c.numero is int && c.numero > d.usosPrevios && c.numero <= d.usosTotales
          && !(c.numero in antes.numerosOcupados)
          && c.numero in d.numerosOcupados
          && d.numerosOcupados.size() == antes.numerosOcupados.size() + 1
          && d.numerosOcupados.hasAll(antes.numerosOcupados)
          && d.fechasUso.diff(antes.fechasUso).affectedKeys() == [n].toSet()
          && n in d.fechasUso
          && !exists(refUso(c.usoId))
          && getAfter(refUso(c.usoId)).data.numeroUso == c.numero
          && getAfter(refUso(c.usoId)).data.estado == 'VIGENTE'
          && getAfter(refUso(c.usoId)).data.fecha == d.fechasUso[n];
      }
      // Baja: el número de un uso vigente se libera (con su fecha) y ese uso
      // queda anulado.
      function esBaja() {
        let antes = resource.data;
        let d = request.resource.data;
        let c = d.ultimoCambio;
        let n = string(c.numero);
        return c.tipo == 'BAJA'
          && c.numero in antes.numerosOcupados
          && !(c.numero in d.numerosOcupados)
          && d.numerosOcupados.size() == antes.numerosOcupados.size() - 1
          && antes.numerosOcupados.hasAll(d.numerosOcupados)
          && d.fechasUso.diff(antes.fechasUso).affectedKeys() == [n].toSet()
          && !(n in d.fechasUso)
          && get(refUso(c.usoId)).data.estado == 'VIGENTE'
          && get(refUso(c.usoId)).data.numeroUso == c.numero
          && getAfter(refUso(c.usoId)).data.estado == 'ANULADO';
      }
      // La gestión de un uso vigente cambió de fecha: cambia solo esa fecha.
      function esCambioFecha() {
        let antes = resource.data;
        let d = request.resource.data;
        let c = d.ultimoCambio;
        let n = string(c.numero);
        return c.tipo == 'FECHA'
          && c.numero in d.numerosOcupados
          && d.fechasUso.diff(antes.fechasUso).affectedKeys() == [n].toSet()
          && n in d.fechasUso
          && d.fechasUso[n] <= d.vencimiento
          && getAfter(refUso(c.usoId)).data.numeroUso == c.numero
          && getAfter(refUso(c.usoId)).data.estado == 'VIGENTE'
          && getAfter(refUso(c.usoId)).data.fecha == d.fechasUso[n];
      }
      function cambiaUso() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usosConsumidos', 'numerosOcupados', 'fechasUso', 'estado', 'ultimoCambio', 'actualizadoEl'])
          && fibraCoherente(request.resource.data)
          && (esAlta() || esBaja() || esCambioFecha());
      }
      // Corrección desde la pantalla (con motivo, y su log en la misma
      // escritura): usos totales sin quedar bajo los consumidos ni bajo un
      // número ocupado; vencimiento sin quedar antes de ningún uso vigente;
      // lote solo sin usos registrados en el sistema.
      function esCorreccion() {
        let antes = resource.data;
        let d = request.resource.data;
        let cambia = d.diff(antes).affectedKeys();
        return cambia.hasOnly(['lote', 'vencimiento', 'usosTotales', 'estado', 'ultimaCorreccion', 'actualizadoEl', 'actualizadoPor'])
          && fibraCoherente(d)
          && (!cambia.hasAny(['lote']) || antes.numerosOcupados.size() == 0)
          && esFechaISO(d.vencimiento)
          && sinUsoPosterior(d.fechasUso, d.vencimiento)
          && d.lote is string && d.lote.size() > 0
          && d.actualizadoPor.uid == request.auth.uid
          && cambia.hasAny(['ultimaCorreccion'])
          && d.ultimaCorreccion.motivo is string && d.ultimaCorreccion.motivo.size() > 0
          && existsAfter(/databases/$(database)/documents/implantes_fibras/$(fibraId)/logs/$(d.ultimaCorreccion.logId))
          && accionFibras('tabla_fibras', 'action_editar');
      }

      allow read: if estaActivo() && (esDev() || tienePermiso('implantes'));
      allow create: if estaActivo() && accionFibras('encabezado', 'btn_registrar_fibra')
        && request.resource.data.codigoInterno == fibraId
        && fibraId.matches('FIB-[0-9]{4,}')
        && fibraCoherente(request.resource.data)
        && request.resource.data.numerosOcupados.size() == 0
        && request.resource.data.usosPrevios < request.resource.data.usosTotales
        && request.resource.data.ultimoCambio == null
        && esFechaISO(request.resource.data.vencimiento)
        && request.resource.data.lote is string && request.resource.data.lote.size() > 0
        && request.resource.data.referencia is string && request.resource.data.referencia.size() > 0
        && request.resource.data.creadoPor.uid == request.auth.uid;
      allow update: if estaActivo() && (esDev() || tienePermiso('implantes')) && (cambiaUso() || esCorreccion());
      allow delete: if false;

      match /usos/{usoId} {
        function fibraAntes() {
          return get(/databases/$(database)/documents/implantes_fibras/$(fibraId)).data;
        }
        function cambioFibra() {
          return getAfter(/databases/$(database)/documents/implantes_fibras/$(fibraId)).data.ultimoCambio;
        }
        function anulacion() {
          let d = request.resource.data;
          let c = cambioFibra();
          return d.diff(resource.data).affectedKeys().hasOnly(['estado', 'anuladoEl', 'anuladoPor', 'motivoAnulacion', 'detalleAnulacion'])
            && d.estado == 'ANULADO'
            && d.anuladoPor.uid == request.auth.uid
            && c != null && c.tipo == 'BAJA' && c.usoId == usoId && c.numero == resource.data.numeroUso
            && (resource.data.tipo == 'USO'
              ? d.motivoAnulacion in ['LINEA_ELIMINADA', 'GESTION_ELIMINADA', 'REFERENCIA_CAMBIADA', 'FIBRA_CAMBIADA']
              : (d.motivoAnulacion == 'PERDIDA_ANULADA' && d.detalleAnulacion is string
                && d.detalleAnulacion.size() > 0 && anulaPerdidas()));
        }
        // La gestión cambió de ruta, paciente, médico, empresa o fecha. Una
        // fecha nueva va con su cambio en fechasUso de la fibra (FECHA).
        function actualizacionGestion() {
          let d = request.resource.data;
          let cambia = d.diff(resource.data).affectedKeys();
          return resource.data.tipo == 'USO'
            && cambia.hasOnly(['gestionId', 'paciente', 'medico', 'empresa', 'fecha', 'gestionRefPath', 'actualizadoEl'])
            && esFechaISO(d.fecha) && d.fecha <= fibraAntes().vencimiento
            && (!cambia.hasAny(['fecha'])
              || (cambioFibra().tipo == 'FECHA' && cambioFibra().usoId == usoId && cambioFibra().numero == resource.data.numeroUso));
        }

        allow read: if estaActivo() && (esDev() || tienePermiso('implantes'));
        allow create: if estaActivo() && (esDev() || tienePermiso('implantes'))
          && request.resource.data.estado == 'VIGENTE'
          && request.resource.data.fibraId == fibraId
          && request.resource.data.usosTotales == fibraAntes().usosTotales
          && request.resource.data.registradoPor.uid == request.auth.uid
          && esFechaISO(request.resource.data.fecha)
          && cambioFibra() != null && cambioFibra().tipo == 'ALTA' && cambioFibra().usoId == usoId
          && cambioFibra().numero == request.resource.data.numeroUso
          && ((request.resource.data.tipo == 'USO' && request.resource.data.fecha <= fibraAntes().vencimiento)
            || (request.resource.data.tipo == 'PERDIDA' && request.resource.data.motivo is string
              && request.resource.data.motivo.size() > 0 && accionFibras('tabla_fibras', 'action_registrar_perdida')));
        allow update: if estaActivo() && (esDev() || tienePermiso('implantes'))
          && resource.data.estado == 'VIGENTE'
          && (anulacion() || actualizacionGestion());
        allow delete: if false;
      }

      match /logs/{logId} {
        allow read: if estaActivo() && (esDev() || tienePermiso('implantes'));
        allow create: if estaActivo() && (esDev() || tienePermiso('implantes'))
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Correlativo de los códigos internos (FIB-0001…): solo sube.
    match /implantes_fibras_control/{docId} {
      allow read: if estaActivo() && (esDev() || tienePermiso('implantes'));
      function escribeContador() {
        return estaActivo() && docId == 'contador'
          && accionFibras('encabezado', 'btn_registrar_fibra')
          && request.resource.data.ultimo is int;
      }
      allow create: if escribeContador() && request.resource.data.ultimo > 0;
      allow update: if escribeContador() && request.resource.data.ultimo > resource.data.ultimo;
    }

    // Implantes → Respaldo de documentos: PDF cuyo ID no coincide con ninguna
    // gestión. Solo se lee con la vista; eliminar es lógico (papelera) y solo
    // "eliminar definitivamente" borra el registro.
    match /implantes_respaldo_documentos/{docId} {
      function vistaRespaldo() {
        return esDev() || (tienePermiso('implantes') && tieneItem('implantes', '/implantes/respaldoDocumentos'));
      }
      function enRespaldo(seccion, accion) {
        return accionEnVista('implantes', '/implantes/respaldoDocumentos', seccion, accion);
      }
      allow read: if estaActivo() && vistaRespaldo();
      allow create: if estaActivo()
        && enRespaldo('acciones', 'btn_subir')
        && request.resource.data.eliminado == false
        && request.resource.data.ruta is string
        && request.resource.data.ruta.matches('implantes_respaldo/' + docId + '/.+');
      // Solo enviar a la papelera / restaurar (no se editan los datos).
      allow update: if estaActivo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eliminado', 'eliminadoPor', 'eliminadoEl'])
        && (request.resource.data.eliminado == true
          ? enRespaldo('tabla_documentos', 'btn_eliminar')
          : enRespaldo('papelera', 'btn_restaurar'));
      allow delete: if estaActivo() && enRespaldo('papelera', 'btn_eliminar_definitivo');
    }

    // Hemodinamia → Respaldo de documentos: mismas reglas que Implantes.
    match /hemodinamia_respaldo_documentos/{docId} {
      function vistaRespaldo() {
        return esDev() || (tienePermiso('hemodinamia') && tieneItem('hemodinamia', '/hemodinamia/respaldoDocumentos'));
      }
      function enRespaldo(seccion, accion) {
        return accionEnVista('hemodinamia', '/hemodinamia/respaldoDocumentos', seccion, accion);
      }
      allow read: if estaActivo() && vistaRespaldo();
      allow create: if estaActivo()
        && enRespaldo('acciones', 'btn_subir')
        && request.resource.data.eliminado == false
        && request.resource.data.ruta is string
        && request.resource.data.ruta.matches('hemodinamia_respaldo/' + docId + '/.+');
      // Solo enviar a la papelera / restaurar (no se editan los datos).
      allow update: if estaActivo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eliminado', 'eliminadoPor', 'eliminadoEl'])
        && (request.resource.data.eliminado == true
          ? enRespaldo('tabla_documentos', 'btn_eliminar')
          : enRespaldo('papelera', 'btn_restaurar'));
      allow delete: if estaActivo() && enRespaldo('papelera', 'btn_eliminar_definitivo');
    }

    // Documentos → Archivo digital: carpetas y archivos (padreId) en una sola
    // colección. Cada cambio se valida contra la acción granular que lo
    // permite: crear carpeta / subir, renombrar, mover, eliminar (lógico,
    // eliminadoGrupo = nodo eliminado; el contenido de una carpeta se marca
    // con el permiso de eliminar carpetas), restaurar y eliminar definitivo.
    match /documentos_archivo/{nodoId} {
      function vistaArchivo() {
        return esDev() || (tienePermiso('documentos') && tieneItem('documentos', '/documentos/archivoDigital'));
      }
      function enArchivo(seccion, accion) {
        return accionEnVista('documentos', '/documentos/archivoDigital', seccion, accion);
      }
      function seccionDe(tipo) {
        return tipo == 'carpeta' ? 'carpetas' : 'archivos';
      }
      function cambios() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      allow read: if estaActivo() && vistaArchivo();
      allow create: if estaActivo()
        && request.resource.data.eliminado == false
        && ((request.resource.data.tipo == 'carpeta' && enArchivo('carpetas', 'btn_crear'))
          || (request.resource.data.tipo == 'archivo'
            && request.resource.data.ruta is string
            && request.resource.data.ruta.matches('documentos_archivo/' + nodoId + '/.+')
            && enArchivo('archivos', 'btn_subir')));
      allow update: if estaActivo()
        && request.resource.data.tipo == resource.data.tipo
        && (
          // Renombrar
          (resource.data.eliminado == false
            && cambios().hasOnly(['nombre', 'actualizadoEl'])
            && enArchivo(seccionDe(resource.data.tipo), 'btn_renombrar'))
          // Mover (con " (2)" si el nombre ya existe en el destino)
          || (resource.data.eliminado == false
            && cambios().hasAny(['padreId'])
            && cambios().hasOnly(['padreId', 'nombre', 'actualizadoEl'])
            && enArchivo(seccionDe(resource.data.tipo), 'btn_mover'))
          // Enviar a la papelera
          || (resource.data.eliminado == false
            && request.resource.data.eliminado == true
            && cambios().hasOnly(['eliminado', 'eliminadoEl', 'eliminadoPor', 'eliminadoGrupo'])
            && enArchivo(request.resource.data.eliminadoGrupo == nodoId ? seccionDe(resource.data.tipo) : 'carpetas', 'btn_eliminar'))
          // Restaurar
          || (resource.data.eliminado == true
            && request.resource.data.eliminado == false
            && cambios().hasOnly(['eliminado', 'eliminadoEl', 'eliminadoPor', 'eliminadoGrupo', 'padreId'])
            && enArchivo('papelera', 'btn_restaurar'))
        );
      allow delete: if estaActivo() && enArchivo('papelera', 'btn_eliminar_definitivo');
    }

    // Administración → Estadísticas: documentos precalculados por módulo y
    // período ({modulo}_{AAAA-MM}, {id}__codigos, {id}__montos, sus partes
    // ...__pN y el índice _indice). Solo lectura, con la vista y el filtro del
    // módulo del documento (opt_implantes, opt_consignacion, opt_hemodinamia);
    // los de montos exigen además la acción "Ver montos". Solo escriben las
    // Cloud Functions y el script inicial (Admin SDK, no pasan por reglas).
    match /estadisticas/{docId} {
      allow read: if estaActivo() && (esDev()
        || (tienePermiso('administracion')
          && tieneItem('administracion', '/administracion/estadisticas')
          && (docId == '_indice'
            || (accionPermitida('/administracion/estadisticas', 'filtros', 'opt_' + docId.split('_')[0])
              && (!docId.matches('.*__montos.*')
                || accionPermitida('/administracion/estadisticas', 'acciones', 'ver_montos'))))));
      allow write: if false;
    }

    // =================================================================
    // HEMODINAMIA
    // =================================================================

    match /hemodinamia_gestiones/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('hemodinamia'));
    }

    match /hemodinamia_imputadas/{document=**} {
      allow read: if estaActivo();
      allow write: if estaActivo() && (esDev() || tienePermiso('hemodinamia'));
    }

  }
}
