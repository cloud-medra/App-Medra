rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {

    function getUsuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    // Sesión de un usuario activo (mismo criterio que firestore.rules: un
    // token emitido antes de inactivarlo sigue valiendo hasta una hora).
    // Sin perfil o sin el campo `activo`, se considera activo.
    function estaActivo() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
          || getUsuario().get('activo', true) != false);
    }
    function esAdminODev() {
      let u = getUsuario();
      return u.rol == 'admin' || u.rol == 'dev';
    }
    function tienePermiso(modulo) {
      let u = getUsuario();
      return u.permisos[modulo] != null;
    }
    // Mismo criterio que firestore.rules (tieneItem / accionPermitida /
    // accionEnVista): ítem de menú + acción granular de la vista. Las
    // acciones de ACCIONES_DENEGADAS_POR_DEFECTO no se validan aquí.
    function tieneItem(modulo, ruta) {
      return ruta in getUsuario().permisos.get(modulo, []);
    }
    function accionPermitida(ruta, seccion, accion) {
      let vista = getUsuario().get('permisosGranulares', {}).get(ruta, null);
      let sec = vista == null ? null : vista.get(seccion, null);
      return vista != null
        && (sec == null || (sec.get('visible', true) != false
          && sec.get('elements', {}).get(accion, true) != false));
    }
    function accionEnVista(modulo, ruta, seccion, accion) {
      return esAdminODev()
        || (tienePermiso(modulo) && tieneItem(modulo, ruta) && accionPermitida(ruta, seccion, accion));
    }

    // Snapshot de comparación de "Importar Detalles OC" (documentos_sistema),
    // usado para minimizar lecturas de Firestore en cada importación.
    // Es un artefacto interno de la importación, no un documento de negocio,
    // así que a diferencia del patrón de lectura abierta de firestore.rules
    // se restringe también la lectura al mismo permiso que la escritura.
    match /snapshots/documentos_sistema/{archivo} {
      allow read, write: if estaActivo() && (esAdminODev() || tienePermiso('documentos'));
    }

    // Índice de OC (Importar Detalles OC -> "Sincronizar OC" de Gestión de
    // Implantes). Lo escribe la importación y lo lee la sincronización solo
    // cuando cambió ocImport/meta. Contiene nombres de pacientes: mismo nivel
    // que snapshots/documentos_sistema, más el permiso implantes (lo lee el
    // botón "Sincronizar OC").
    // Consignación también lo lee (su "Sincronizar OC" llena el N° de orden de
    // consignacion_registros), pero no lo escribe.
    match /snapshots/indiceOC/{archivo} {
      allow read: if estaActivo() && (esAdminODev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('consignacion'));
      allow write: if estaActivo() && (esAdminODev() || tienePermiso('documentos') || tienePermiso('implantes'));
    }

    // PDFs de cada admisión de Implantes (pestaña Documentos de Gestión
    // Implantes). Solo "create": nunca se sobrescribe ni se borra desde la
    // app; ante un nombre repetido el cliente usa "(2)", "(3)"...
    // El chequeo de permiso (getUsuario) cuesta 1 lectura de Firestore por
    // operación (listar, subir cada PDF, abrir uno). Se mantiene a propósito
    // también en "create": son documentos con datos de pacientes.
    match /implantes/{admision}/documentos/{archivo} {
      allow read: if estaActivo() && (esAdminODev() || tienePermiso('implantes'));
      allow create: if estaActivo()
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('.*\\.pdf$')
        && request.resource.size < 20 * 1024 * 1024
        && (esAdminODev() || tienePermiso('implantes'));
    }

    // PDF de órdenes de compra: UNO por OC (ordenes_oc/OC_{oc}.pdf),
    // compartido por todas las admisiones/empresas que usan esa OC. Se
    // permite "update" para reemplazarlo (la app pregunta antes); nunca se
    // borra. Contienen datos de pacientes: lectura solo con permiso, vía
    // getBlob (sin URLs públicas). Tope: 15 MB.
    // Consignación solo puede verlos/descargarlos (pestaña Orden de Cargas).
    match /ordenes_oc/{archivo} {
      allow read: if estaActivo() && (esAdminODev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('consignacion'));
      allow create, update: if estaActivo()
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('OC_[^/]+\\.pdf')
        && request.resource.size < 15 * 1024 * 1024
        && (esAdminODev() || tienePermiso('documentos') || tienePermiso('implantes'));
    }

    // Implantes → Respaldo de documentos (PDF hasta 20 MB). Leer exige ver o
    // descargar. Borrar: "eliminar definitivamente" o, para quien sube, el
    // archivo huérfano cuyo registro en Firestore no llegó a crearse.
    match /implantes_respaldo/{docId}/{archivo} {
      allow read: if estaActivo()
        && (accionEnVista('implantes', '/implantes/respaldoDocumentos', 'tabla_documentos', 'btn_ver')
          || accionEnVista('implantes', '/implantes/respaldoDocumentos', 'tabla_documentos', 'btn_descargar'));
      allow create: if estaActivo()
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('.*\\.pdf$')
        && request.resource.size <= 20 * 1024 * 1024
        && accionEnVista('implantes', '/implantes/respaldoDocumentos', 'acciones', 'btn_subir');
      allow delete: if estaActivo()
        && (accionEnVista('implantes', '/implantes/respaldoDocumentos', 'papelera', 'btn_eliminar_definitivo')
          || (accionEnVista('implantes', '/implantes/respaldoDocumentos', 'acciones', 'btn_subir')
            && !firestore.exists(/databases/(default)/documents/implantes_respaldo_documentos/$(docId))));
    }

    // Documentos → Archivo digital (PDF, JPG, PNG, WEBP hasta 25 MB). Mismo
    // criterio que el respaldo; renombrar y mover no tocan Storage.
    match /documentos_archivo/{nodoId}/{archivo} {
      allow read: if estaActivo()
        && (accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_ver')
          || accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_descargar'));
      allow create: if estaActivo()
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
        && request.resource.size <= 25 * 1024 * 1024
        && accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_subir');
      allow delete: if estaActivo()
        && (accionEnVista('documentos', '/documentos/archivoDigital', 'papelera', 'btn_eliminar_definitivo')
          || (accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_subir')
            && !firestore.exists(/databases/(default)/documents/documentos_archivo/$(nodoId))));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}