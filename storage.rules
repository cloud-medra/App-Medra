rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {

    function getUsuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    // Sesión de un usuario activo (mismo criterio que firestore.rules: un
    // token emitido antes de inactivarlo sigue valiendo hasta una hora).
    // Sin perfil o sin el campo `activo`, se considera activo.
    function estaActivo() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
          || getUsuario().get('activo', true) != false);
    }
    // Desarrollador: único rol con acceso total (igual que firestore.rules).
    function esDev() {
      return getUsuario().get('rol', '') == 'dev';
    }
    function tienePermiso(modulo) {
      return getUsuario().get('permisos', {}).get(modulo, null) != null;
    }
    // Mismo criterio que firestore.rules (tieneItem / accionPermitida /
    // accionEnVista): ítem de menú + acción granular de la vista. Las
    // acciones de ACCIONES_DENEGADAS_POR_DEFECTO no se validan aquí.
    function tieneItem(modulo, ruta) {
      return ruta in getUsuario().permisos.get(modulo, []);
    }
    function accionPermitida(ruta, seccion, accion) {
      // Sección sin configurar = {} (permitida). Sin `null` en el ternario: el
      // verificador de tipos del deploy no puede asegurar que sea un map
      // (aviso "Invalid type. Received one of [null]. Expected one of [map]").
      let vista = getUsuario().get('permisosGranulares', {}).get(ruta, null);
      let sec = vista == null ? {} : vista.get(seccion, {});
      return vista != null
        && sec.get('visible', true) != false
        && sec.get('elements', {}).get(accion, true) != false;
    }
    function accionEnVista(modulo, ruta, seccion, accion) {
      return esDev()
        || (tienePermiso(modulo) && tieneItem(modulo, ruta) && accionPermitida(ruta, seccion, accion));
    }

    // Snapshot de comparación de "Importar Detalles OC" (documentos_sistema),
    // usado para minimizar lecturas de Firestore en cada importación.
    // Es un artefacto interno de la importación, no un documento de negocio,
    // así que a diferencia del patrón de lectura abierta de firestore.rules
    // se restringe también la lectura al mismo permiso que la escritura
    // (Documentos, o el ítem Implantes → Importar Detalles OC).
    match /snapshots/documentos_sistema/{archivo} {
      allow read, write: if estaActivo() && (esDev() || tienePermiso('documentos')
        || tieneItem('implantes', '/implantes/importarDetallesOC'));
    }

    // Índice de OC (Importar Detalles OC -> "Sincronizar OC" de Gestión de
    // Implantes y de Hemodinamia). Lo escribe la importación y lo lee la
    // sincronización solo cuando cambió ocImport/meta. Contiene nombres de
    // pacientes: mismo nivel que snapshots/documentos_sistema, más el permiso
    // implantes o hemodinamia (lo lee el botón "Sincronizar OC").
    // Consignación también lo lee (su "Sincronizar OC" llena el N° de orden de
    // consignacion_registros), pero no lo escribe.
    match /snapshots/indiceOC/{archivo} {
      allow read: if estaActivo() && (esDev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('hemodinamia') || tienePermiso('consignacion'));
      allow write: if estaActivo() && (esDev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('hemodinamia'));
    }

    // PDFs de cada admisión de Implantes (pestaña Documentos de Gestión
    // Implantes). Solo "create": nunca se sobrescribe ni se borra desde la
    // app; ante un nombre repetido el cliente usa "(2)", "(3)"...
    // `resource == null` (el archivo no existe aún) hace explícito el "no
    // sobrescribir": en producción sobrescribir se evalúa como "update" (no
    // permitido aquí), pero el emulador de Storage lo evalúa como "create" y
    // sin esta condición dejaba pisar el PDF. Igual en Hemodinamia, en los
    // respaldos y en Archivo digital (tests/emulador/reglasHemodinamia.test.js).
    // El chequeo de permiso (getUsuario) cuesta 1 lectura de Firestore por
    // operación (listar, subir cada PDF, abrir uno). Se mantiene a propósito
    // también en "create": son documentos con datos de pacientes.
    match /implantes/{admision}/documentos/{archivo} {
      allow read: if estaActivo() && (esDev() || tienePermiso('implantes'));
      allow create: if estaActivo()
        && resource == null
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('.*\\.pdf$')
        && request.resource.size < 20 * 1024 * 1024
        && (esDev() || tienePermiso('implantes'));
    }

    // PDFs de cada admisión de Hemodinamia: mismas reglas que Implantes
    // (pestaña Documentos y Carga masiva de documentos de Hemodinamia).
    match /hemodinamia/{admision}/documentos/{archivo} {
      allow read: if estaActivo() && (esDev() || tienePermiso('hemodinamia'));
      allow create: if estaActivo()
        && resource == null
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('.*\\.pdf$')
        && request.resource.size < 20 * 1024 * 1024
        && (esDev() || tienePermiso('hemodinamia'));
    }

    // PDF de órdenes de compra: UNO por OC (ordenes_oc/OC_{oc}.pdf),
    // compartido por todas las admisiones/empresas que usan esa OC. Se
    // permite "update" para reemplazarlo (la app pregunta antes); nunca se
    // borra. Contienen datos de pacientes: lectura solo con permiso, vía
    // getBlob (sin URLs públicas). Tope: 15 MB.
    // Hemodinamia, igual que Implantes (pestaña Orden de su Gestión).
    // Consignación solo puede verlos/descargarlos (pestaña Orden de Cargas).
    match /ordenes_oc/{archivo} {
      allow read: if estaActivo() && (esDev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('hemodinamia') || tienePermiso('consignacion'));
      allow create, update: if estaActivo()
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('OC_[^/]+\\.pdf')
        && request.resource.size < 15 * 1024 * 1024
        && (esDev() || tienePermiso('documentos') || tienePermiso('implantes') || tienePermiso('hemodinamia'));
    }

    // Implantes → Respaldo de documentos (PDF hasta 20 MB). Leer exige ver o
    // descargar. Borrar: "eliminar definitivamente" o, para quien sube, el
    // archivo huérfano cuyo registro en Firestore no llegó a crearse.
    match /implantes_respaldo/{docId}/{archivo} {
      allow read: if estaActivo()
        && (accionEnVista('implantes', '/implantes/respaldoDocumentos', 'tabla_documentos', 'btn_ver')
          || accionEnVista('implantes', '/implantes/respaldoDocumentos', 'tabla_documentos', 'btn_descargar'));
      allow create: if estaActivo()
        && resource == null
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('.*\\.pdf$')
        && request.resource.size <= 20 * 1024 * 1024
        && accionEnVista('implantes', '/implantes/respaldoDocumentos', 'acciones', 'btn_subir');
      allow delete: if estaActivo()
        && (accionEnVista('implantes', '/implantes/respaldoDocumentos', 'papelera', 'btn_eliminar_definitivo')
          || (accionEnVista('implantes', '/implantes/respaldoDocumentos', 'acciones', 'btn_subir')
            && !firestore.exists(/databases/(default)/documents/implantes_respaldo_documentos/$(docId))));
    }

    // Hemodinamia → Respaldo de documentos: mismas reglas que Implantes.
    match /hemodinamia_respaldo/{docId}/{archivo} {
      allow read: if estaActivo()
        && (accionEnVista('hemodinamia', '/hemodinamia/respaldoDocumentos', 'tabla_documentos', 'btn_ver')
          || accionEnVista('hemodinamia', '/hemodinamia/respaldoDocumentos', 'tabla_documentos', 'btn_descargar'));
      allow create: if estaActivo()
        && resource == null
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('.*\\.pdf$')
        && request.resource.size <= 20 * 1024 * 1024
        && accionEnVista('hemodinamia', '/hemodinamia/respaldoDocumentos', 'acciones', 'btn_subir');
      allow delete: if estaActivo()
        && (accionEnVista('hemodinamia', '/hemodinamia/respaldoDocumentos', 'papelera', 'btn_eliminar_definitivo')
          || (accionEnVista('hemodinamia', '/hemodinamia/respaldoDocumentos', 'acciones', 'btn_subir')
            && !firestore.exists(/databases/(default)/documents/hemodinamia_respaldo_documentos/$(docId))));
    }

    // Documentos → Archivo digital (PDF, JPG, PNG, WEBP hasta 25 MB). Mismo
    // criterio que el respaldo; renombrar y mover no tocan Storage.
    match /documentos_archivo/{nodoId}/{archivo} {
      allow read: if estaActivo()
        && (accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_ver')
          || accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_descargar'));
      allow create: if estaActivo()
        && resource == null
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
        && request.resource.size <= 25 * 1024 * 1024
        && accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_subir');
      allow delete: if estaActivo()
        && (accionEnVista('documentos', '/documentos/archivoDigital', 'papelera', 'btn_eliminar_definitivo')
          || (accionEnVista('documentos', '/documentos/archivoDigital', 'archivos', 'btn_subir')
            && !firestore.exists(/databases/(default)/documents/documentos_archivo/$(nodoId))));
    }

    // Foto de perfil opcional (menú del usuario → Foto de perfil). Cada
    // usuario solo sube, reemplaza o borra la suya: fotos_perfil/{su uid}/.
    // Solo imágenes JPG, PNG o WebP de hasta 1 MB (la app la recorta y la
    // reduce a 256 × 256 px antes de subirla). Sin firestore.get(): no cuesta
    // lecturas de Firestore. La app la muestra con la URL de descarga
    // guardada en usuarios/{uid}.fotoPerfilUrl.
    match /fotos_perfil/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && archivo.matches('foto_[0-9]+[.](webp|jpg)')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size <= 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Capturas de un ticket de soporte (Ayuda y soporte), hasta 3 por ticket:
    // tickets_capturas/{uid del creador}/{ticketId}/captura_N. Solo las sube
    // (o las borra, si el ticket no llegó a crearse) su autor; imágenes de
    // hasta 2 MB (la app las reduce y comprime antes). Las ve su autor y
    // quien tiene "Gestionar tickets" (mismo criterio que gestionaTickets() de
    // firestore.rules). La app las muestra con la URL de descarga guardada en
    // el ticket (que solo leen esas mismas personas), así que mostrarlas no
    // evalúa esta regla ni cuesta lecturas; el firestore.get() del permiso
    // solo corre si quien gestiona las pide por el SDK y no es el autor.
    function gestionaTickets() {
      return esDev()
        || getUsuario().get('rol', '') == 'admin'
        || '/administracion/tickets' in getUsuario().get('permisos', {}).get('administracion', []);
    }
    match /tickets_capturas/{uid}/{ticketId}/{archivo} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || (estaActivo() && gestionaTickets()));
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null
        && archivo.matches('captura_[1-3][.](webp|jpg)')
        && request.resource.contentType in ['image/jpeg', 'image/webp']
        && request.resource.size <= 2 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}